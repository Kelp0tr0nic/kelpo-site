{
  "name": "kelpo-site",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "spikes/m0/eden-treaty",
    "spikes/m0/eden-treaty/apps/api",
    "spikes/m0/eden-treaty/apps/web"
  ],
  "scripts": {
    "verify": "bun run --cwd spikes/m0/eden-treaty verify",
    "dev": "bun run --filter '*' dev",
    "dev:backend": "bun run --filter backend dev",
    "dev:frontend": "bun run --filter frontend dev",
    "build": "bun run --filter frontend build",
    "start": "bun run --filter backend start"
  }
}
